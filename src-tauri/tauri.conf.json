{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workbuddy2api",
  "version": "0.3.0",
  "identifier": "cn.3304711297.workbuddy2api",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WorkBuddy2API 控制台",
        "width": 960,
        "height": 680,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../converter.py": "converter.py",
      "../anthropic_compat.py": "anthropic_compat.py",
      "../anthropic_stream.py": "anthropic_stream.py",
      "../responses_compat.py": "responses_compat.py",
      "../responses_projection.py": "responses_projection.py",
      "../deepseek_thinking.py": "deepseek_thinking.py",
      "../desensitize.py": "desensitize.py",
      "../request_pacer.py": "request_pacer.py",
      "../token_refresher.py": "token_refresher.py",
      "../wb_atrest.py": "wb_atrest.py",
      "../turing_helper.cjs": "turing_helper.cjs",
      "runtime": "runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
