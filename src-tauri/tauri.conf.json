{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codebuddy2openai",
  "version": "0.1.0",
  "identifier": "cn.3304711297.codebuddy2openai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "CodeBuddy2OpenAI 控制台",
        "width": 960,
        "height": 680,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}