# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/

# 本地运行产物 / 日志
*.log
*.lnk
.DS_Store
Thumbs.db
# 内核运行态数据（本地跑 --usage-log / --snapshots-log 会落在仓库根；默认写 %LOCALAPPDATA%，此处防误入）
usage.jsonl
snapshots.jsonl
# 拆分后的用量日志目录（usage/usage_*.jsonl + snapshots.jsonl）及本地滚动日志
usage/
usage/*.jsonl
usage/*.log
# SQLite 库与 WAL/SHM 边车文件（同名成对生成，只忽略 *.db 会漏掉 -wal / -shm）
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# 个人 / 敏感信息（绝不提交）
*.token
*.key
secrets.*
# WorkBuddy2API 本地运行时配置与凭据（防 token 泄漏，绝不入库）
accounts.json
settings.json
model_settings.json
model_availability.json
window.json
update-check.json
# 旧版兼容目录（曾用名 codebuddy2openai）
codebuddy2openai/
codebuddy2openai.json
# 环境变量文件（常含 API Key / 端点覆盖），保留 .env.example 模板可提交
.env
.env.*
!.env.example
# 证书 / 密钥容器
*.pem
*.p12

# 前端构建产物（Vite -> dist/，Tauri frontendDist 引用）
dist/
node_modules/


# Rust/Tauri 编译产物
src-tauri/target/
# 备用 target 目录（在 GUI 占用 exe 时用于旁路构建）——必须忽略，否则会误提交 GB 级产物
src-tauri/target-*/
target-*/

# worktrees (superpowers workflow)
.worktrees/

# 编辑器目录 / 本地临时文件（如需共享编辑器配置，对被忽略目录内的目标文件显式反选）
.idea/
.vscode/
*.bak
*.tmp

# 看门巡检临时报告（仅用于 CI 生成 Issue，不入库）
upstream-report.md
